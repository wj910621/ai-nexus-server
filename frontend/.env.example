# 前端（Vite）环境变量模板
# 复制为 .env（本地）或通过 Docker 构建期 ARG 注入（生产，见 release.yml build-frontend build-args）。

# API / WebSocket 基础地址（本地联合启动 / 开发代理）
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws
# SPA 路由基址（react-router base；生产共享域名为 /story）
VITE_ROUTER_BASE=

# Y.NEX / Jarvis 计费门户地址
VITE_JARVIS_BILLING_PORTAL_URL=https://ynexai.cn/

# 商业化开关（构建期注入）：默认 'false'。仅在完成全部生产验收并经审批后置 'true'。
# 与后端 COMMERCIAL_OPERATIONS_ENABLED 保持一致；生产由 release.yml 注入。
VITE_COMMERCIAL_OPERATIONS_ENABLED=false

# ---------- 生产共享域名部署（ynexai.cn/story/）覆盖以下本地值 ----------
# VITE_BASE_PATH=/story/
# VITE_ROUTER_BASE=/story
# VITE_API_BASE_URL=/story-api
# VITE_WS_BASE_URL=/story-ws
