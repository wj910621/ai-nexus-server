# ============================================================
# Y路NEX Story Studio - 后端环境变量模板（全量 / All settings）
# ============================================================
# 复制为 .env 并按环境填写。生产环境务必使用安全随机值。
# 下列 fail-closed 项在 production 下若缺失/为占位值，应用启动将拒绝。
# 生产 Secret 契约: docs/deployment/production-secret-contract.md
# 上线运行手册: docs/deployment/PRODUCTION_LAUNCH_RUNBOOK.md

# ---------- 应用基础 / App ----------
APP_NAME=Y路NEX Story Studio
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me        # 生产：>=32 字符随机值（fail-closed）
CS_DESKTOP_MODE=1               # 1=桌面/本地（SQLite）; 留空/0=服务模式

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://comic_user:comic_password@localhost:5432/comic_studio

# ---------- Redis（限流/缓存/配额/消息队列） ----------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=           # 空=复用 REDIS_URL；'none'=强制关闭
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=300
CACHE_REDIS_URL=               # 空=复用 REDIS_URL；'memory'=强制内存
CACHE_KEY_PREFIX=cs:
CACHE_MAX_SIZE_MEMORY=10000
QUOTA_REDIS_URL=                # 空=复用 REDIS_URL

# ---------- MinIO（本地/桌面对象存储） ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ---------- JWT 认证 ----------
JWT_SECRET_KEY=change-me-to-a-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_ENABLED=true

# ---------- WebSocket 滥用防护 ----------
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=20
WS_MAX_MESSAGES_PER_MINUTE=120
WS_MAX_CHANNEL_LENGTH=256
WS_MAX_MESSAGE_BYTES=1048576
STORAGE_CLEANUP_INTERVAL_SECONDS=300

# ---------- 邮件（注册验证/重置） ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@comicstudio.local
SMTP_USE_TLS=true

# ---------- 计费 / 商业化（重要） ----------
# BILLING_MODE: jarvis=共享Y.NEX主站统一账本; standalone=独立Stripe(旧)
BILLING_MODE=jarvis
# 商业化总开关: 默认 false（安全）。仅在完成全部生产验收并经审批后置 true（构建期也须 VITE_COMMERCIAL_OPERATIONS_ENABLED=true）
COMMERCIAL_OPERATIONS_ENABLED=false
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
JARVIS_BILLING_PORTAL_URL=https://ynexai.cn/
ADMIN_BOOTSTRAP_EMAIL=           # 首个管理员邮箱（首次启动授予 admin）

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Celery 任务队列 ----------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- 并发 / 引擎 ----------
MAX_CONCURRENT_TASKS=4
ENGINE_MAX_CONCURRENT_IMAGE=5
ENGINE_MAX_CONCURRENT_LLM=10
ENGINE_MAX_CONCURRENT_TTS=8
ENGINE_MAX_CONCURRENT_VIDEO=2
ENGINE_MAX_CONCURRENT_CHARACTER=3
ENGINE_ACQUIRE_TIMEOUT_SECONDS=30

# ---------- 可观测性 / 告警 ----------
SENTRY_DSN=
LOG_FORMAT=text                # text | json
LOG_LEVEL=INFO
METRICS_ENABLED=true
METRICS_PATH=/metrics
ACCESS_LOG_ENABLED=true
ALERTING_WEBHOOK_URL=          # 生产：HTTPS 运维 webhook（Alertmanager 目标，fail-closed）
BACKUP_DIR=/var/backups/comicstudio
BACKUP_ENCRYPTION_KEY=         # Fernet(base64,32B)；生产必填，缺失则 fail-closed
UPLOADS_DIR=uploads

# ---------- AI / 推理 ----------
MODEL_CACHE_DIR=./ai-models
DEVICE=cpu                     # cpu | gpu
RUN_MIGRATIONS_ON_STARTUP=true   # 生产应由 CI/Job 用 alembic 迁移，此处 false

# ---------- 主站 Y.NEX SSO / 计费桥（生产关键，fail-closed） ----------
YNEX_SSO_SECRET=               # 与主站 STORY_SSO_SECRET 相同；>=32 字符
YNEX_SSO_ISSUER=ynexai.cn
YNEX_SSO_AUDIENCE=story-studio
YNEX_BILLING_BASE_URL=https://ynexai.cn
YNEX_BILLING_SERVICE_TOKEN=    # 与主站 STORY_SERVICE_TOKEN 相同；>=32 字符
JARVIS_GATEWAY_ENABLED=false
JARVIS_GATEWAY_BASE_URL=
JARVIS_GATEWAY_SERVICE_TOKEN=  # 主站签发计费服务凭证；>=32 字符
JARVIS_GATEWAY_DEFAULT_MODEL=
JARVIS_GATEWAY_TIMEOUT_SECONDS=60

# ---------- 内容模型 Provider（图像/视频/TTS/LLM） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DOUBAO_API_KEY=
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_TTS_API_KEY=
VOLCANO_TTS_API_SECRET=
VOLCANO_TTS_API_BASE=https://openspeech.bytedance.com/api/v1
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
VOLCANO_API_KEY=
VOLCANO_API_SECRET=
VOLCANO_API_BASE=https://visual.volcengineapi.com
KLING_API_KEY=
KLING_API_SECRET=
KLING_API_BASE=https://api.kuaishou.com/kling
KOLORS_API_KEY=
KOLORS_API_SECRET=
KOLORS_API_BASE=https://api.kuaishou.com/kolors

# ---------- CDN / 对象存储 ----------
CDN_PROVIDER=none              # none | r2 | qiniu
CDN_R2_ACCOUNT_ID=
CDN_R2_ACCESS_KEY=
CDN_R2_SECRET_KEY=
CDN_R2_BUCKET=
CDN_R2_PUBLIC_URL=
CDN_QINIU_ACCESS_KEY=
CDN_QINIU_SECRET_KEY=
CDN_QINIU_BUCKET=
CDN_QINIU_DOMAIN=
# 阿里云 OSS（Phase 8 P4 生产）
OSS_ENABLED=false
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=

# ---------- Provider 容错 ----------
FAILOVER_ENABLED=true
FAILOVER_CIRCUIT_THRESHOLD=5
FAILOVER_CIRCUIT_RESET_SECONDS=60

# ---------- 本地推理（桌面模式） ----------
LOCAL_INFERENCE_ENABLED=false
LOCAL_INFERENCE_DEVICE=auto    # auto | gpu | cpu
LOCAL_MODEL_DIR=
LOCAL_GPU_MIN_VRAM_GB=6
LOCAL_CPU_MIN_RAM_GB=8
LOCAL_DIFFUSERS_MODEL=stable-diffusion-xl-base-1.0
LOCAL_LLM_MODEL=Qwen2.5-7B-Instruct-Q4_K_M
LOCAL_TTS_MODEL=en_US-lessac-medium

# ---------- 语义缓存 ----------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.90
SEMANTIC_CACHE_TTL_SECONDS=1800
SEMANTIC_CACHE_MAX_ENTRIES_PER_USER=1000
SEMANTIC_CACHE_CHROMA_PERSIST_DIR=./.chroma
SEMANTIC_CACHE_EMBEDDING_MODEL=BAAI/bge-m3
SEMANTIC_CACHE_MIN_MAX_TOKENS=100

# ---------- 订阅 / 配额 ----------
SUBSCRIPTION_JWT_SECRET=
SUBSCRIPTION_JWT_ISSUER=comicstudio
SUBSCRIPTION_OFFLINE_GRACE_DAYS=7
SUBSCRIPTION_HARDWARE_PROFILES=low,mid,high,cpu
QUOTA_FREE_DAILY_LIMIT=10
QUOTA_PRO_MONTHLY_LIMIT=1000
QUOTA_ENTERPRISE_MONTHLY_LIMIT=0   # 0=不限
QUOTA_SKIP_LOCAL=true

# ---------- 本地模型默认（GPU 打包变量） ----------
LOCAL_FLUX_MODEL=black-forest-labs/FLUX.1-dev
LOCAL_WAN_MODEL=Wan-AI/Wan2.1-T2V-1.3B
LOCAL_HUNYUAN_MODEL=tencent/HunyuanVideo
LOCAL_COSYVOICE_MODEL=FunAudioLLM/CosyVoice-300M
LOCAL_VLLM_GPU_MEMORY_UTILIZATION=0.85
LOCAL_VLLM_MAX_MODEL_LEN=8192

# ---------- 基准 / llama.cpp ----------
BENCHMARK_ENABLED=true
BENCHMARK_CACHE_TTL=3600
LLAMA_CPP_MODEL_PATH=
LLAMA_CPP_N_GPU_LAYERS=-1       # -1=全部；0=纯CPU

# ---------- LoRA 训练 ----------
REPLICATE_API_TOKEN=
REPLICATE_TRAIN_MODEL=
LORA_TRAIN_LOCAL_ENABLED=true
LORA_TRAIN_CLOUD_ENABLED=true
BLIP_MODEL_NAME=Salesforce/blip-image-captioning-large

