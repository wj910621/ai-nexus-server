# ===========================================
# 漫剧生成软件 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ===========================================

# 应用配置
APP_NAME=Y·NEX Story Studio
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret-key-in-production

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=comic_user
DB_PASSWORD=comic_password
DB_NAME=comic_studio
DATABASE_URL=postgresql+asyncpg://comic_user:comic_password@localhost:5432/comic_studio

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_ASSETS=assets
MINIO_BUCKET_GENERATED=generated

# JWT 配置
JWT_SECRET_KEY=change-me-to-a-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# 鏀粯锛堢敓浜х幆澧冨繀椤诲叏閮ㄩ厤缃紝涓嶅厑璁?Mock锛?+STRIPE_ENABLED=false

# 鐢熶骇闄愭祦蹇呴』浣跨敤 Redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=

# CORS 配置 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# WebSocket 防滥用与存储补偿
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=20
WS_MAX_MESSAGES_PER_MINUTE=120
WS_MAX_CHANNEL_LENGTH=256
WS_MAX_MESSAGE_BYTES=1048576
STORAGE_CLEANUP_INTERVAL_SECONDS=300

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI 模型配置
MODEL_CACHE_DIR=./ai-models
SDXL_MODEL_PATH=./ai-models/sdxl-base
SD_MODEL_PATH=./ai-models/sd15
DEVICE=cpu

# DeepSeek API (LLM 剧本生成)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com

# YNEX/Jarvis AI Gateway (server-side only; never expose token to frontend)
JARVIS_GATEWAY_ENABLED=false
JARVIS_GATEWAY_BASE_URL=
JARVIS_GATEWAY_SERVICE_TOKEN=
JARVIS_GATEWAY_DEFAULT_MODEL=
JARVIS_GATEWAY_TIMEOUT_SECONDS=60

# Y·NEX 主站短期会话与共享积分账本（生产环境必须注入同一组受控密钥）
YNEX_SSO_SECRET=
YNEX_SSO_ISSUER=ynexai.cn
YNEX_SSO_AUDIENCE=story-studio
YNEX_BILLING_BASE_URL=https://ynexai.cn
YNEX_BILLING_SERVICE_TOKEN=

# 前端配置
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_JARVIS_BILLING_PORTAL_URL=https://ynexai.cn/

# Y·NEX 同域部署（生产环境覆盖上面的本地值）
# VITE_BASE_PATH=/story/
# VITE_ROUTER_BASE=/story
# VITE_API_BASE_URL=/story-api
# VITE_WS_BASE_URL=/story-ws

# Commercial ledger owner. "jarvis" means no local checkout or local credit charging.
BILLING_MODE=jarvis
JARVIS_BILLING_PORTAL_URL=https://ynexai.cn/

# 商业化总开关（fail-closed）：默认 false。仅在完成全部生产验收并经审批后置 true；
# 前端构建亦须注入 VITE_COMMERCIAL_OPERATIONS_ENABLED=true。
COMMERCIAL_OPERATIONS_ENABLED=false

# 首个管理员邮箱（首次启动授予 admin 角色）
ADMIN_BOOTSTRAP_EMAIL=

# 运维告警（生产必填，Alertmanager 目标，空则 fail-closed）
ALERTING_WEBHOOK_URL=

# 备份加密 Fernet key（base64, 32B）；生产必填，缺失则 fail-closed
BACKUP_ENCRYPTION_KEY=

# 阿里云 OSS 对象存储（Phase 8 P4 生产）
OSS_ENABLED=false
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=

# SMTP（注册验证 / 密码重置）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@comicstudio.local
SMTP_USE_TLS=true
