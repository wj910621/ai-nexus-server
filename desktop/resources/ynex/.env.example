# 复制本文件为 .env，然后填入你的配置

# ===== 在线模型 =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
ONLINE_MODEL=deepseek-chat

# ===== 本地 LLM（隐私优先，无需联网费用）=====
USE_LOCAL_FIRST=false
LOCAL_MODEL=qwen2.5:7b
LOCAL_BASE_URL=http://localhost:11434
LLM_NUM_CTX=8192
LLM_NUM_GPU=-1
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9

# ===== 唤醒词配置 =====
WAKE_WORD=Y·NEX
# 自定义中文唤醒词"Y·NEX"需要以下步骤：
# 1. 运行 python record_wake_word.py 录制 20 条样本
# 2. 访问 https://console.picovoice.ai/ppn 注册并训练
# 3. 下载 .ppn 模型文件，填入下方路径
# 4. 填入 Picovoice Access Key
WAKE_WORD_MODEL_PATH=
WAKE_WORD_ACCESS_KEY=

# ===== 语音 =====
ASR_MODEL=base
ASR_USE_LOCAL=true
TTS_VOICE=zh-CN-YunxiNeural

# ===== 记忆 =====
MEMORY_DB=data/memory.db
MAX_HISTORY=20

# ===== 知识库（RAG）=====
KNOWLEDGE_DIR=data/knowledge
VECTOR_DB_PATH=data/vectors

# ===== 智能家居 Home Assistant =====
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN

# ===== 邮件 =====
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password
IMAP_SERVER=imap.example.com
SMTP_SERVER=smtp.example.com
SMTP_PORT=587

# ===== API 服务器 =====
API_BIND_HOST=127.0.0.1
YNEX_API_PORT=7788
TRUSTED_SUBNETS=127.0.0.1/32
API_KEY_REQUIRED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:7777,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:7777
MAX_CONTENT_LENGTH_MB=64
REQUEST_TIMEOUT_SECONDS=120

# ===== 安全密钥（生产环境必须设置，不少于 32 字节）=====
FLASK_SECRET_KEY=
AUTH_API_KEY_PEPPER=
BILLING_API_KEY_PEPPER=
YNEX_PLUGIN_SECRET=
JWT_SECRET=
ADMIN_PASSWORD=

# ===== 速率限制 =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_BURST=5

# ===== 备份 =====
BACKUP_ENABLED=false
BACKUP_DIR=data/backups
BACKUP_INTERVAL_HOURS=24

# ===== 域名 =====
DOMAIN=https://ynexai.cn
ALLOWED_ORIGINS=https://ynexai.cn,https://www.ynexai.cn,https://j3trisheng.com

# ===== 可选集成 =====
# Paperless-ngx 文档管理
PAPERLESS_URL=
PAPERLESS_TOKEN=
# Immich 照片管理
IMMICH_URL=
IMMICH_API_KEY=
# n8n 工作流（注意：变量名是 N8N_URL，不是 N8N_BASE_URL）
N8N_URL=
N8N_API_KEY=
# Telegram 机器人
TELEGRAM_BOT_TOKEN=

# ===== 支付系统（支付宝/微信）=====
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_KEY=
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_SANDBOX_KEY=
PAYMENT_SANDBOX_CALLBACK_KEY=

# ===== 推送通知 =====
BARK_URL=
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=
QYWX_WEBHOOK=

# ===== MQTT =====
MQTT_BROKER=
MQTT_PORT=

# ===== Redis 缓存（可选）=====
REDIS_URL=

# ===== 高级 LLM 参数 =====
LOCAL_BACKEND=ollama
LLM_TOP_K=40
LLM_REPEAT_PENALTY=1.1
LLM_QUANT_PREFERENCE=Q4_K_M

# ===== 日志 =====
YNEX_LOG_FORMAT=plain
YNEX_LOG_LEVEL=INFO
