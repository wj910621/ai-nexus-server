{
  "name": "ynex-desktop",
  "version": "2.0.0",
  "description": "Y·NEX AI Desktop — Harness Engineering Agent Platform",
  "main": "src/main.js",
  "author": "Y·NEX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:win:nsis": "electron-builder --win nsis",
    "build:win:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^9.0.0",
    "monaco-editor": "^0.55.1",
    "node-fetch": "^2.7.0",
    "screenshot-desktop": "^1.15.4",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ynex.desktop",
    "productName": "Y·NEX Desktop",
    "directories": {
      "output": "../ynex-build-output"
    },
    "files": [
      "**/*",
      "!dist*/**",
      "!dist-*/**",
      "!.electron-cache/**",
      "!*.log",
      "!*.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    },
    "asarUnpack": [
      "node_modules/screenshot-desktop/**/*",
      "node_modules/screenshot-desktop/**/.bin/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "YNEX-Desktop-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "resources/ynex",
        "to": "ynex",
        "filter": [
          "**/*",
          "!.env",
          "!ynex-desktop-dist*/**",
          "!ynex-desktop-portable*/**",
          "!trigenclaw-dist*/**",
          "!**/app.asar",
          "!**/*.pyc",
          "!**/__pycache__/**",
          "!test_*.py",
          "!*_test*.py",
          "!check_*.py",
          "!check_*.js",
          "!deploy*.py",
          "!deploy*.js",
          "!upload*.js",
          "!fix_*.js",
          "!build_*.js",
          "!build_*.py",
          "!rebuild_desktop.js",
          "!*.md",
          "!mobile*.html",
          "!mobile*.json",
          "!mobile*.js",
          "!mobile*.py",
          "!mobile*.sh",
          "!termux*.py",
          "!install_*.bat",
          "!install_*.sh",
          "!install_*.py",
          "!package.json",
          "!package-lock.json",
          "!ynex-demo.html",
          "!landing.html",
          "!download_index_new.html",
          "!icon.svg",
          "!trigenclaw-integration.md",
          "!trigenclaw_build_helper.py",
          "!domain_switch_guide.md"
        ]
      }
    ]
  }
}
