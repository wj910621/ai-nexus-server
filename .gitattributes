# Normalize line endings across platforms
* text=auto

# Python / shell files force LF (important for Linux CI)
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
nginx.conf text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
*.tar.gz binary
*.mp3 binary
*.wasm binary
